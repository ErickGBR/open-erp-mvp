NODE_ENV=development

# PostgreSQL
POSTGRES_DB=openerp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# Redis (optional — available but not required by backend yet)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=openerp

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=1d

# Frontend
FRONTEND_URL=http://localhost:3000

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# OAuth — Microsoft 365
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3001/api/auth/microsoft/callback

# App mode — when true, landing page is skipped and app goes to setup/login
DISABLE_LANDING=false
